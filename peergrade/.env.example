# Copy to .env on the server; fill values privately. Never commit real secrets.
DOMAIN=example.org
PUBLIC_ORIGIN=https://example.org
POSTGRES_PASSWORD=replace-with-a-strong-random-password
# Percent-encode special characters in the database password in this URL.
DATABASE_URL=postgresql+psycopg://peergrade:replace-with-a-strong-random-password@db:5432/peergrade
AI_API_URL=
AI_API_KEY=
AI_MODEL=
# Optional official DeepSeek: AI_API_URL=https://api.deepseek.com/chat/completions
# AI_MODEL=deepseek-flash; set the key only in your private environment.
